{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "temperature": 0.0,
      "steps": 15
    }
  },
  "instructions": [
    "~/.opencode/instructions/EZRA_SYSTEM.txt"
  ],
  "tools": { "todowrite": false, "skill": false, "websearch": false, "webfetch": false, "task": false, "glob": false, "grep": false },
  "provider": {
    "opencode": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "oauth": true
    },
    "oci": {
      "type": "local",
      "command": ["python3", "/Users/mac/.opencode/mcp/oci_server.py"],
      "enabled": true
    }
  }
}
