<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brachat.agent.artur</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mac/brachat-main/agents/agent_daemon.py</string>
        <string>--agent</string>
        <string>artur</string>
