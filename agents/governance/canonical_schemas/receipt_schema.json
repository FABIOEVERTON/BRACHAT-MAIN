{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "title": "BRACHAT Agent Receipt Schema",
  "description": "Canonical receipt.json schema. Every agent must produce a receipt after each dispatched action. Proves work was done.",
  "type": "object",
  "required": ["receipt_id", "agent_id", "agent_name", "type", "timestamp", "action", "outcome", "evidence"],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^RCP-[A-Z]+-[0-9]{8}-[0-9]{4}$",
      "description": "Format: RCP-{AGENT}-{YYYYMMDD}-{SEQUENCE}"
    },
    "agent_id": { "type": "string", "pattern": "^BR-" },
    "agent_name": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "session",
        "gate_validation",
        "spec_dispatch",
        "code_build",
        "compliance_check",
        "sales_action",
        "job_application",
        "email_sent",
        "study_delivery",
        "ssh_operation",
        "skill_created",
        "consolidation"
      ],
      "description": "Receipt type matching the agent's domain"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "action": {
      "type": "object",
      "required": ["description", "target"],
      "properties": {
        "description": { "type": "string", "maxLength": 500 },
        "target": { "type": "string", "description": "What was acted upon (file, email, API, SSH, etc.)" },
        "params": { "type": "object", "description": "Key parameters of the action" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["status", "summary"],
      "properties": {
        "status": { "type": "string", "enum": ["success", "failure", "blocked", "skipped"] },
        "summary": { "type": "string", "maxLength": 500 },
        "error": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "files_created": { "type": "array", "items": { "type": "string" } },
        "files_modified": { "type": "array", "items": { "type": "string" } },
        "output": { "type": "string", "maxLength": 2000 }
      }
    },
    "worklog_entry": {
      "type": "string",
      "description": "Corresponding line in worklog.jsonl, format: worklog.jsonl@{timestamp}"
    }
  }
}
