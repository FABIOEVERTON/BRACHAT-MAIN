#!/usr/bin/env python3
import os
import sys
import json

def get_project_root():
    # Retorna o diretorio raiz do Git atual
    cwd = os.getcwd()
    while cwd != os.path.dirname(cwd):
        if os.path.exists(os.path.join(cwd, ".git")):
            return cwd
        cwd = os.path.dirname(cwd)
    return None

def main():
    root = get_project_root()
    if not root:
        print("⚠️ Erro: Diretório Git não encontrado.")
        sys.exit(1)
        
    state_path = os.path.join(root, ".brachat-state.json")
    if not os.path.exists(state_path):
        # Se nao houver arquivo de estado do Brachat, permite o commit por padrão (ou bloqueia dependendo da política)
        # Para ser estrito: obrigar a ter o estado do Brachat
        print("🛑 BLOQUEADO: Este repositório exige o arquivo de estado .brachat-state.json para commitar!")
        sys.exit(1)
        
    try:
        with open(state_path, "r") as f:
            state = json.load(f)
    except Exception as e:
        print(f"🛑 BLOQUEADO: Erro ao ler o arquivo de estado .brachat-state.json: {str(e)}")
        sys.exit(1)
        
    phase = state.get("phase", "backlog")
    plan_approved = state.get("plan_approved", False)
    
    # Validações rígidas
    if phase != "development":
        print(f"🛑 BLOQUEADO: Commit rejeitado!")
        print(f"   Você está na fase '{phase.upper()}'.")
        print(f"   Modificações e commits de código só são permitidos na fase 'DEVELOPMENT'.")
        sys.exit(1)
        
    if not plan_approved:
        print("🛑 BLOQUEADO: Você não pode commitar alterações de código sem aprovação prévia do plano técnico!")
        print("   Aprove o plano de implementação no Telegram ou atualize 'plan_approved' para true no estado.")
        sys.exit(1)
        
    print("✅ Validado pelo BRACHÁT: Permissão de commit concedida.")
    sys.exit(0)

if __name__ == "__main__":
    main()
