[Unit]
Description=BRACHAT ClickUp Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/brachat/integrations/clickup
EnvironmentFile=/opt/brachat/.env
ExecStart=/usr/bin/python3 /opt/brachat/integrations/clickup/clickup_daemon.py --poll
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
