# Plataforma EZRA — variáveis de ambiente (PRD Apêndice A)
# Copie para .env e preencha. Nunca commitar .env real (.gitignore).

# --- Banco (Postgres 16) — host port 5433 (5432 está em uso pelo langfuse local) ---
DATABASE_URL=postgresql://ezra:dev_password@localhost:5433/ezra

# --- Redis — host port 6380 (6379 está em uso pelo langfuse local) ---
REDIS_URL=redis://localhost:6380/0

# --- Auth (JWT) ---
JWT_SECRET=change-me
JWT_SERVICE_SECRET=change-me-inter-service

# --- AWS (dev = LocalStack; prod = sa-east-1, ADR-008) ---
AWS_REGION=sa-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_WORM_BUCKET=ezra-worm
S3_WORM_MODE=COMPLIANCE
S3_WORM_DAYS=3650

# --- App ---
EZRA_ENV=development
LOG_LEVEL=INFO