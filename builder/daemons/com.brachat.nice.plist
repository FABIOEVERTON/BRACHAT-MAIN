<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brachat.nice</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/opencode</string>
        <string>run</string>
        <string>--continue</string>
        <string>--agent</string>
        <string>nice</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.brachat.nice.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.brachat.nice.stderr.log</string>
</dict>
</plist>
