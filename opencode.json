{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions/mandatory_fixed_rules.md",
    ".opencode/instructions/manifest.md",
    ".opencode/instructions/persona.md",
    ".opencode/instructions/pending_tasks.md",
    ".opencode/instructions/manifest_tools.md",
    ".opencode/instructions/ROTINA_ESTUDOS.md"
  ],
  "mcp": {
    "brachat-mcp": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/server.mjs"
      ],
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": false,
      "headers": {
        "x-consumer-api-key": "${COMPOSIO_API_KEY}"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/mcp/**": "deny"
    },
    "glob": {
      "*": "allow",
      "**/mcp/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/mcp/**": "deny"
    },
    "write": {
      "*": "allow",
      "**/mcp/**": "deny"
    },
    "bash": {
      "*": "allow"
    },
    "task": {
      "*": "ask"
    }
  }
}