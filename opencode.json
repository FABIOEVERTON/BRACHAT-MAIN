{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/memory.md"],
  "provider": {
    "ollama-local": {
      "name": "Ollama Local (Gemma 3)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma3": {
          "name": "Gemma 3 4.3B (local fallback)",
          "family": "gemma3",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    },
    "cohere": {
      "name": "Cohere Cloud",
      "options": {
        "apiKey": "323QVsj8zNXLOBCu5v9KGJ1D0MTDKJWIr1DSUbxp"
      },
      "models": {
        "command": {
          "name": "Cohere Command (Fast)",
          "family": "command",
          "limit": {
            "context": 4096,
            "output": 4096
          }
        }
      }
    }
  },
  "small_model": "cohere/command"
}
